# SMTP settings for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=SocialFirst <your-email@gmail.com>

# Use a long random secret in production. If omitted, LOGIN_SECRET_KEY is used.
RESET_CODE_SECRET=replace-with-a-long-random-secret
